<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Anime List Pribadi</title>
    <style>
        :root {
            --primary: #ff69b4; /* Kamu bisa ganti warna ini sesuai selera */
            --bg: #121212;
            --card: #1e1e1e;
            --text: #ffffff;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
        }

        header {
            text-align: center;
            padding: 20px 0;
        }

        .filter-buttons {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        button {
            background: var(--card);
            color: white;
            border: 1px solid var(--primary);
            padding: 8px 15px;
            border-radius: 20px;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover, button.active {
            background: var(--primary);
            color: black;
        }

        .anime-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
        }

        .anime-card {
            background: var(--card);
            border-radius: 10px;
            overflow: hidden;
            transition: transform 0.2s;
            border-bottom: 3px solid var(--primary);
        }

        .anime-card:hover {
            transform: scale(1.05);
        }

        .anime-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .info {
            padding: 10px;
        }

        .info h3 {
            font-size: 1rem;
            margin: 0 0 5px 0;
        }

        .status {
            font-size: 0.8rem;
            padding: 2px 8px;
            border-radius: 5px;
            background: #333;
        }
    </style>
</head>
<body>

<header>
    <h1>My Anime Collection 🗿</h1>
    <div class="filter-buttons">
        <button class="active" onclick="filterAnime('all')">Semua</button>
        <button onclick="filterAnime('watching')">Watching</button>
        <button onclick="filterAnime('completed')">Tamat</button>
    </div>
</header>

<div class="anime-grid" id="animeGrid">
    </div>

<script>
    // EDIT DATA ANIME KAMU DI SINI 🗿
    const animeData = [
        {
            title: "Otonari no Tenshi-sama",
            status: "completed",
            image: "https://via.placeholder.com/150x200?text=Tenshi-sama",
            rating: "10/10"
        },
        {
            title: "One Piece",
            status: "watching",
            image: "https://via.placeholder.com/150x200?text=One+Piece",
            rating: "9/10"
        },
        {
            title: "Solo Leveling",
            status: "completed",
            image: "https://via.placeholder.com/150x200?text=Solo+Leveling",
            rating: "8.5/10"
        }
    ];

    function displayAnime(filter) {
        const grid = document.getElementById('animeGrid');
        grid.innerHTML = '';

        const filtered = filter === 'all' ? animeData : animeData.filter(a => a.status === filter);

        filtered.forEach(anime => {
            grid.innerHTML += `
                <div class="anime-card">
                    <img src="${anime.image}" alt="${anime.title}">
                    <div class="info">
                        <h3>${anime.title}</h3>
                        <span class="status">${anime.status.toUpperCase()}</span>
                        <p style="font-size: 0.8rem; color: #aaa;">⭐ ${anime.rating}</p>
                    </div>
                </div>
            `;
        });
    }

    function filterAnime(status) {
        // Ganti button aktif
        document.querySelectorAll('button').forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');
        
        displayAnime(status);
    }

    // Jalankan saat pertama kali buka
    displayAnime('all');
</script>

</body>
</html>
